FrameWidgetClass rootFrame {
 position 0 0
 size 1 1
 halign center_ref
 valign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass MainPanel {
   ignorepointer 0
   size 0.5 0.6
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    TextWidgetClass TextTitle {
     ignorepointer 1
     color 0.0039 0.0039 0.0039 1
     position 0 20
     size 110 48
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Bold
     text "Quests"
     "text color" 0.0039 0.0039 0.0039 1
    }
   }
  }
 }
}